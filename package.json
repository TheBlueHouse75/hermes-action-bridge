{
  "name": "hermes-action-bridge",
  "version": "0.6.3",
  "description": "Configurable bridge for external agents to delegate actions to Hermes Agent via CLI or MCP.",
  "mcpName": "io.github.TheBlueHouse75/hermes-action-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBlueHouse75/hermes-action-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/TheBlueHouse75/hermes-action-bridge/issues"
  },
  "homepage": "https://github.com/TheBlueHouse75/hermes-action-bridge#readme",
  "type": "module",
  "bin": {
    "hermes-action": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/*.md",
    "examples",
    "plugins"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "inspect:mcpb": "node scripts/inspect-mcpb.mjs",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "hermes-agent",
    "codex",
    "claude-code",
    "mcp",
    "agent",
    "automation"
  ],
  "author": "Cyril Guilleminot",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  }
}
